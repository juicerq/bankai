{
	"name": "bankai-2",
	"version": "0.2.24",
	"private": true,
	"description": "Focused Electron workspace for persistent project shell sessions",
	"homepage": "https://github.com/juicerq/bankai-2",
	"repository": {
		"type": "git",
		"url": "https://github.com/juicerq/bankai-2.git"
	},
	"author": {
		"name": "juicerq",
		"email": "julio.cerqueiira@gmail.com"
	},
	"productName": "Bankai",
	"appId": "io.github.juicerq.bankai2",
	"type": "module",
	"main": "./out/main/index.js",
	"engines": {
		"bun": ">=1.3.0"
	},
	"scripts": {
		"dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
		"build": "electron-vite build",
		"preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
		"dist": "electron-vite build && electron-builder --publish never",
		"dist:linux": "electron-vite build && electron-builder --linux --publish never",
		"dist:win": "electron-vite build && electron-builder --win --publish never",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"routes:generate": "tsr generate",
		"typecheck": "tsc --build",
		"check": "bun run routes:generate && juicerq-check",
		"prepare": "simple-git-hooks"
	},
	"simple-git-hooks": {
		"pre-commit": "bun run check"
	},
	"dependencies": {
		"@heroicons/react": "^2.2.0",
		"@orpc/client": "^1.14.0",
		"@orpc/server": "^1.14.0",
		"@orpc/tanstack-query": "^1.14.0",
		"@shikijs/core": "^4.3.1",
		"@shikijs/engine-javascript": "^4.3.1",
		"@shikijs/langs": "^4.3.1",
		"@tanstack/react-query": "^5.99.2",
		"@tanstack/react-router": "^1.168.23",
		"@tanstack/react-store": "^0.11.0",
		"@tanstack/react-virtual": "^3.14.7",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/xterm": "^6.0.0",
		"arktype": "^2.2.0",
		"electron-updater": "^6.8.9",
		"node-pty": "^1.1.0",
		"react": "^19.2.5",
		"react-dom": "^19.2.5"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.11.1",
		"@juicerq/check": "file:../agent-setup/check",
		"@tailwindcss/vite": "^4.2.4",
		"@tanstack/router-cli": "^1.167.21",
		"@tanstack/router-plugin": "^1.167.22",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.0.0",
		"bun-types": "^1.3.13",
		"electron": "^43.2.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "^4.0.0",
		"oxlint": "^1.62.0",
		"oxlint-tsgolint": "^0.22.1",
		"simple-git-hooks": "^2.13.1",
		"tailwindcss": "^4.2.4",
		"typescript": "^7.0.2",
		"vite": "^6.0.0"
	}
}
