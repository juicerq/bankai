{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"paths": {
			"@main/*": ["./src/main/*"],
			"@preload/*": ["./src/preload/*"],
			"@shared/*": ["./src/shared/*"]
		}
	},
	"include": ["src/preload/**/*", "src/shared/**/*"]
}
